---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import SectionList from '@/components/SectionList.astro';
import { lastChanged, longDate } from '@/lib/git';
import SiteNav from '@/components/SiteNav.astro';
import Pop from '@/components/popins/Pop';
import { getReadyLectures } from '@/lib/book';
import { chapterLabel, chapterName, chapterUrl, REPO_BRANCH, REPO_SLUG, SITE_NAME, type Lecture, type Part } from '@/lib/book';

interface Props {
  lecture: Lecture;
  part: Part;
  headings: MarkdownHeading[];
  prev?: Lecture;
  next?: Lecture;
  prerequisites: Lecture[];
}

const { lecture, part, headings, prev, next, prerequisites } = Astro.props;
const { title, number, summary, question, minutes } = lecture.data;

// The dataset the chapter works with, and the other chapters that use the same one.
const dataset = lecture.data.dataset ? await getEntry('datasets', lecture.data.dataset) : undefined;
if (lecture.data.dataset && !dataset) throw new Error(`${lecture.id}: unknown dataset "${lecture.data.dataset}"`);
const sharers = dataset
  ? (await getReadyLectures()).filter((l) => l.data.dataset === dataset.id && l.id !== lecture.id)
  : [];
const hasExercises = (lecture.body ?? '').includes('<Exercises>');
const sections = headings.filter((h) => h.depth === 2 && h.text !== 'Key Takeaways' && h.text !== 'References');

// The same list is shown beside the text on wide screens and in a pull-up sheet on small ones.
const sectionLinks = [
  ...sections.map((s, i) => ({ href: `#${s.slug}`, label: s.text, tag: `${number}.${i + 1}` })),
  ...(hasExercises ? [{ href: '#exercises', label: 'Exercises', tag: '' }] : []),
];

// Symbols a reader can point at inside a formula. "d" is left out: it also appears in dy/dx.
const notation = Object.fromEntries(
  (await getCollection('notation')).filter((n) => n.data.symbol.length === 1 && n.data.symbol !== 'd').map((n) => [n.data.symbol, n.data.meaning]),
);

const updated = lecture.filePath ? lastChanged(lecture.filePath) : undefined;
const editUrl = lecture.filePath ? `https://github.com/${REPO_SLUG}/edit/${REPO_BRANCH}/${lecture.filePath}` : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Chapter',
  name: title,
  description: summary,
  isPartOf: { '@type': 'Book', name: SITE_NAME, url: Astro.site?.href },
  url: new URL(chapterUrl(lecture), Astro.site).href,
  isAccessibleForFree: true,
};
---

<BaseLayout title={`${title} — ${SITE_NAME}`} description={summary} jsonLd={jsonLd} shareImage={lecture.id}>
  <div id="reading-bar" aria-hidden="true" class="fixed top-0 left-0 z-40 h-[3px] w-full origin-left scale-x-0 bg-orange-600"></div>
  <main id="top" class="px-6 pt-10 pb-24 sm:pt-16 sm:pb-32">
    <div class="relative mx-auto max-w-3xl">
      <SiteNav />

      <header class="mb-16">
        <div class="mb-8 flex items-center gap-4">
          <div class="h-[2px] w-12 bg-stone-900"></div>
          <div class="micro-label text-[11px] tracking-[0.4em] text-stone-900">
            {chapterLabel(number)} // <a href={`/parts/${part.id}/`} class="hover:text-orange-600">{part.data.title}</a>
          </div>
        </div>
        <h1 data-pagefind-meta="title" class="display mb-8 text-[clamp(2rem,9.5vw,3rem)] leading-[1.05] break-words hyphens-auto sm:text-6xl md:text-7xl">{title}{/[?!.]$/.test(title) ? '' : '.'}</h1>
        <p class="max-w-2xl text-2xl leading-relaxed font-light text-stone-500 italic">{question ?? summary}</p>

        <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-2 font-mono text-[11px] text-stone-500">
          {
            minutes && (
              <div class="flex gap-2">
                <dt class="font-bold tracking-widest uppercase">Reading time</dt>
                <dd>{minutes} min</dd>
              </div>
            )
          }
          {
            dataset && (
              <div class="flex gap-2">
                <dt class="font-bold tracking-widest uppercase">Data</dt>
                <dd>
                  <Pop
                    client:idle
                    reference
                    heading={dataset.data.name}
                    body={dataset.data.about}
                    links={sharers.map((l) => ({ lead: 'Also in', label: chapterName(l), href: chapterUrl(l) }))}
                  >
                    {dataset.data.name}
                  </Pop>
                </dd>
              </div>
            )
          }
          {
            prerequisites.length > 0 && (
              <div class="flex gap-2">
                <dt class="font-bold tracking-widest uppercase">Read first</dt>
                <dd>
                  {prerequisites.map((p, i) => (
                    <>
                      {i > 0 && ', '}
                      <a class="underline decoration-orange-300 underline-offset-2 hover:text-orange-600" href={chapterUrl(p)} data-prerequisite={p.id}>
                        {p.data.title}
                      </a>
                    </>
                  ))}
                  <span id="prerequisite-note" hidden class="ml-2 text-orange-700" />
                </dd>
              </div>
            )
          }
        </dl>
      </header>

      {/* Section list: beside the text on very wide screens, above it otherwise. */}
      {
        sections.length > 0 && (
          <nav aria-label="In this chapter" class="mb-12 min-[1280px]:absolute min-[1280px]:top-0 min-[1280px]:right-full min-[1280px]:mr-10 min-[1280px]:mb-0 min-[1280px]:h-full min-[1280px]:w-44 min-[1500px]:mr-16 min-[1500px]:w-48">
            <div class="min-[1280px]:sticky min-[1280px]:top-10">
              <div class="micro-label mb-3 text-stone-400">In this chapter</div>
              <SectionList links={sectionLinks} />
            </div>
          </nav>
        )
      }

      <article data-pagefind-body data-pagefind-meta={`kind:${chapterLabel(number)}`} class="book-prose" style={`--chapter: '${number}'`} data-chapter-id={lecture.id} data-chapter-title={title} data-chapter-label={chapterLabel(number)}>
        <slot />
      </article>

      <p class="mt-16 flex flex-wrap gap-x-6 gap-y-1 font-sans text-xs text-stone-400" data-print-hide>
        {updated && <span>Last updated <time datetime={updated}>{longDate(updated)}</time></span>}
        {editUrl && (
          <a href={editUrl} rel="noopener" class="underline decoration-stone-300 underline-offset-2 hover:text-orange-700">
            Spotted a mistake? Suggest an edit
          </a>
        )}
        <a href="/changelog/" class="underline decoration-stone-300 underline-offset-2 hover:text-orange-700">What changed</a>
      </p>

      <nav id="chapter-end" aria-label="Chapters" class="mt-10 grid gap-4 border-t-2 border-stone-900 pt-8 font-sans sm:grid-cols-2">
        {
          prev ? (
            <a href={chapterUrl(prev)} rel="prev" class="group block">
              <div class="micro-label mb-1 text-stone-400">‹ Previous</div>
              <div class="display text-lg group-hover:text-orange-700">{prev.data.title}</div>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={chapterUrl(next)} rel="next" class="group block sm:text-right">
              <div class="micro-label mb-1 text-stone-400">Next ›</div>
              <div class="display text-lg group-hover:text-orange-700">{next.data.title}</div>
            </a>
          ) : (
            <a href="/" class="group block sm:text-right">
              <div class="micro-label mb-1 text-stone-400">More chapters are on the way</div>
              <div class="display text-lg group-hover:text-orange-700">Back to contents</div>
            </a>
          )
        }
      </nav>
    </div>
  </main>

  {/* On screens too narrow for the side list: a button that pulls the list up, and one that goes to the top. */}
  <button
    type="button"
    data-open="sections-window"
    data-print-hide
    aria-label="Sections of this chapter, search and settings"
    class="float-button fixed right-3 bottom-3 z-30 min-[1280px]:hidden"
  >
    ≡
  </button>
  <dialog id="sections-window" aria-label="In this chapter" class="site-dialog w-[min(26rem,calc(100vw-1.5rem))]">
    <div class="mb-4 flex items-center justify-between">
      <span class="micro-label text-stone-900">In this chapter</span>
      <button type="button" data-close class="micro-label cursor-pointer p-2 text-stone-500 hover:text-stone-900">Close</button>
    </div>
    <SectionList links={[{ href: '#top', label: 'Top of the chapter', tag: '' }, ...sectionLinks]} large />
    <div class="mt-5 grid grid-cols-2 gap-2 border-t border-stone-100 pt-4 font-sans text-sm">
      <a href="/search/" data-open="search-window" class="rounded border border-stone-200 px-3 py-2.5 text-center text-stone-700">Search</a>
      <button type="button" data-open="settings-window" class="cursor-pointer rounded border border-stone-200 px-3 py-2.5 text-stone-700">Text and colours</button>
      {prev && <a href={chapterUrl(prev)} class="rounded border border-stone-200 px-3 py-2.5 text-center text-stone-700">‹ Previous</a>}
      {next && <a href={chapterUrl(next)} class="rounded border border-stone-200 px-3 py-2.5 text-center text-stone-700">Next ›</a>}
    </div>
  </dialog>

  <div id="symbol-tip" role="tooltip" hidden class="pointer-events-none fixed z-50 max-w-64 rounded border border-stone-900 bg-white px-3 py-2 font-serif text-[13px] leading-snug text-stone-700 shadow-xl"></div>
  <script is:inline type="application/json" id="notation-data" set:html={JSON.stringify(notation)} />
</BaseLayout>

<script>
  import '@/scripts/chapter';
</script>
