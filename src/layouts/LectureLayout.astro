---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SiteNav from '@/components/SiteNav.astro';
import { chapterLabel, chapterUrl, SITE_NAME, type Lecture, type Part } from '@/lib/book';

interface Props {
  lecture: Lecture;
  part: Part;
  headings: MarkdownHeading[];
  prev?: Lecture;
  next?: Lecture;
  prerequisites: Lecture[];
}

const { lecture, part, headings, prev, next, prerequisites } = Astro.props;
const { title, number, summary, question, minutes } = lecture.data;
const sections = headings.filter((h) => h.depth === 2 && h.text !== 'Key Takeaways' && h.text !== 'References');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Chapter',
  name: title,
  description: summary,
  isPartOf: { '@type': 'Book', name: SITE_NAME, url: Astro.site?.href },
  url: new URL(chapterUrl(lecture), Astro.site).href,
  isAccessibleForFree: true,
};
---

<BaseLayout title={`${title} — ${SITE_NAME}`} description={summary} jsonLd={jsonLd}>
  <div id="reading-bar" aria-hidden="true" class="fixed top-0 left-0 z-40 h-[3px] w-full origin-left scale-x-0 bg-orange-600"></div>
  <main class="px-6 pt-16 pb-32">
    <div class="relative mx-auto max-w-3xl">
      <SiteNav />

      <header class="mb-16">
        <div class="mb-8 flex items-center gap-4">
          <div class="h-[2px] w-12 bg-stone-900"></div>
          <div class="micro-label text-[11px] tracking-[0.4em] text-stone-900">
            {chapterLabel(number)} // {part.data.title}
          </div>
        </div>
        <h1 data-pagefind-meta="title" class="display mb-8 text-[clamp(2rem,9.5vw,3rem)] leading-[1.05] break-words hyphens-auto sm:text-6xl md:text-7xl">{title}{/[?!.]$/.test(title) ? '' : '.'}</h1>
        <p class="max-w-2xl text-2xl leading-relaxed font-light text-stone-500 italic">{question ?? summary}</p>

        <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-2 font-mono text-[11px] text-stone-500">
          {
            minutes && (
              <div class="flex gap-2">
                <dt class="font-bold tracking-widest uppercase">Reading time</dt>
                <dd>{minutes} min</dd>
              </div>
            )
          }
          {
            prerequisites.length > 0 && (
              <div class="flex gap-2">
                <dt class="font-bold tracking-widest uppercase">Read first</dt>
                <dd>
                  {prerequisites.map((p, i) => (
                    <>
                      {i > 0 && ', '}
                      <a class="underline decoration-orange-300 underline-offset-2 hover:text-orange-600" href={chapterUrl(p)}>
                        {p.data.title}
                      </a>
                    </>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </header>

      {/* Section list: beside the text on very wide screens, above it otherwise. */}
      {
        sections.length > 0 && (
          <nav aria-label="In this chapter" class="mb-12 min-[1280px]:absolute min-[1280px]:top-0 min-[1280px]:right-full min-[1280px]:mr-10 min-[1280px]:mb-0 min-[1280px]:h-full min-[1280px]:w-44 min-[1500px]:mr-16 min-[1500px]:w-48">
            <div class="min-[1280px]:sticky min-[1280px]:top-10">
              <div class="micro-label mb-3 text-stone-400">In this chapter</div>
              <ol id="section-list" class="space-y-1.5 border-l border-stone-100 font-sans text-[13px] leading-snug text-stone-500">
                {sections.map((s, i) => (
                  <li>
                    <a href={`#${s.slug}`} class="-ml-px block border-l border-transparent pl-4 transition-colors hover:text-orange-600">
                      <span class="mr-1.5 font-mono text-[10px] text-stone-400">{number}.{i + 1}</span>
                      {s.text}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </nav>
        )
      }

      <article data-pagefind-body data-pagefind-meta={`kind:${chapterLabel(number)}`} class="book-prose" style={`--chapter: '${number}'`} data-chapter-id={lecture.id} data-chapter-title={title} data-chapter-label={chapterLabel(number)}>
        <slot />
      </article>

      <nav id="chapter-end" aria-label="Chapters" class="mt-24 grid gap-4 border-t-2 border-stone-900 pt-8 font-sans sm:grid-cols-2">
        {
          prev ? (
            <a href={chapterUrl(prev)} class="group block">
              <div class="micro-label mb-1 text-stone-400">‹ Previous</div>
              <div class="display text-lg group-hover:text-orange-700">{prev.data.title}</div>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={chapterUrl(next)} class="group block sm:text-right">
              <div class="micro-label mb-1 text-stone-400">Next ›</div>
              <div class="display text-lg group-hover:text-orange-700">{next.data.title}</div>
            </a>
          ) : (
            <a href="/" class="group block sm:text-right">
              <div class="micro-label mb-1 text-stone-400">More chapters are on the way</div>
              <div class="display text-lg group-hover:text-orange-700">Back to contents</div>
            </a>
          )
        }
      </nav>
    </div>
  </main>
</BaseLayout>

<style>
  #section-list a[aria-current='true'] {
    border-left-color: var(--accent);
    color: var(--ink);
    font-weight: 600;
  }
</style>

<script>
  import { markRead, noteOpened } from '@/lib/progress';

  const article = document.querySelector<HTMLElement>('article[data-chapter-id]');
  if (article) {
    const { chapterId = '', chapterTitle = '', chapterLabel = '' } = article.dataset;
    noteOpened(chapterId, chapterTitle, chapterLabel);

    // The chapter counts as read once its last lines have been on screen.
    const end = document.getElementById('chapter-end');
    if (end) {
      const seen = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          markRead(chapterId);
          seen.disconnect();
        }
      });
      seen.observe(end);
    }

    // Thin bar at the top of the window: how far through the chapter the reader is.
    const bar = document.getElementById('reading-bar');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('#section-list a')];
    const headings = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((h): h is HTMLElement => h !== null);

    let queued = false;
    const update = () => {
      queued = false;
      const box = article.getBoundingClientRect();
      const done = Math.min(1, Math.max(0, -box.top / Math.max(1, box.height - window.innerHeight)));
      if (bar) bar.style.transform = `scaleX(${done})`;
      // The current section is the last heading that has passed the top third of the window.
      let current = -1;
      headings.forEach((h, i) => {
        if (h.getBoundingClientRect().top < window.innerHeight / 3) current = i;
      });
      links.forEach((a, i) => (i === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    // A copy button on every code block.
    for (const pre of article.querySelectorAll('pre')) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = 'Copy';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Press Ctrl+C';
        }
        setTimeout(() => (button.textContent = 'Copy'), 1600);
      });
      const frame = document.createElement('div');
      frame.className = 'code-frame';
      pre.replaceWith(frame);
      frame.append(pre, button);
    }

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  }
</script>
