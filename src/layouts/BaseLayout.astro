---
import '@/styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE_NAME } from '@/lib/book';
import SiteChrome from '@/components/SiteChrome.astro';
import { PREFS_KEY } from '@/lib/prefs';

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search engines (kit page, 404). */
  noindex?: boolean;
  /** Extra JSON-LD for this page. */
  jsonLd?: Record<string, unknown>;
  /** Name of the share picture in public/og/, without the extension. */
  shareImage?: string;
  /** Set to false on the search page, which has its own search box. */
  searchWindow?: boolean;
}

const { title, description, noindex = false, jsonLd, shareImage = 'home', searchWindow = true } = Astro.props;
const image = new URL(`/og/${shareImage}.png`, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <meta name="theme-color" content="#1c1917" />
    {/* Applies the reader's text size and colours before anything is drawn. Mirrors src/lib/prefs.ts. */}
    <script is:inline define:vars={{ PREFS_KEY }}>
      try {
        const p = JSON.parse(localStorage.getItem(PREFS_KEY) || '{}');
        const dark = p.theme === 'dark' || (p.theme === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.size = p.size === 's' || p.size === 'l' ? p.size : 'm';
      } catch {
        // No stored preferences: the defaults apply.
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen">
    <slot />
    <SiteChrome searchWindow={searchWindow} />
  </body>
</html>
