---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteNav from '@/components/SiteNav.astro';
import { SITE_NAME } from '@/lib/book';
import { longDate } from '@/lib/git';

const entries = (await getCollection('changelog')).sort((a, b) => b.data.date.localeCompare(a.data.date) || 0);
const iso = (date: string) => date.slice(0, 10);
---

<BaseLayout title={`What changed — ${SITE_NAME}`} description="New chapters and features in the book, newest first.">
  <main class="px-6 pt-16 pb-32">
    <div class="mx-auto max-w-3xl">
      <SiteNav />
      <header class="mb-12">
        <div class="mb-8 flex items-center gap-4">
          <div class="h-[2px] w-12 bg-stone-900"></div>
          <div class="micro-label text-[11px] tracking-[0.4em] text-stone-900">Reference</div>
        </div>
        <h1 class="display mb-6 text-5xl leading-[1.05] sm:text-6xl">What changed.</h1>
        <p class="max-w-2xl text-xl leading-relaxed font-light text-stone-500 italic">New chapters and features, newest first.</p>
      </header>

      <ol class="border-t-2 border-stone-900">
        {
          entries.map((entry) => (
            <li class="border-b border-stone-100 py-6">
              <time datetime={iso(entry.data.date)} class="micro-label text-orange-600">{longDate(iso(entry.data.date))}</time>
              <h2 class="display mt-1 text-xl">{entry.data.title}</h2>
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-base leading-relaxed text-stone-700 marker:text-stone-400">
                {entry.data.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
</BaseLayout>
