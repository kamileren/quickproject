---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { chapterName, chapterUrl, SITE_NAME, termHomes } from '@/lib/book';

const homes = await termHomes();
const all = await getCollection('glossary');
const names = new Map(all.map((e) => [e.id, e.data.term]));

// Only terms a published chapter introduces, so every entry has somewhere to go.
const entries = all
  .filter((e) => homes.has(e.id))
  .sort((a, b) => a.data.term.localeCompare(b.data.term, 'en', { sensitivity: 'base' }));

const letters = [...new Set(entries.map((e) => e.data.term[0].toUpperCase()))];
const description = `Every term the book defines, ${entries.length} of them, each in a sentence or two with a link to the chapter that introduces it.`;
---

<BaseLayout current="glossary" title={`Glossary — ${SITE_NAME}`} description={description}>
  <main class="px-5 pt-10 pb-24 sm:px-6 sm:pt-14 sm:pb-32">
    <div class="mx-auto max-w-3xl">
      <header class="mb-12">
        <div class="mb-8 flex items-center gap-4">
          <div class="h-[2px] w-12 bg-stone-900"></div>
          <div class="micro-label text-[11px] tracking-[0.4em] text-stone-900">Reference</div>
        </div>
        <h1 data-pagefind-meta="title" class="display mb-6 text-5xl leading-[1.05] sm:text-6xl">Glossary</h1>
        <p class="max-w-2xl text-xl leading-relaxed font-light text-stone-500 italic">
          {entries.length} terms, each in a sentence or two, with the chapter that introduces it.
        </p>
      </header>

      <input
        id="term-filter"
        type="search"
        aria-label="Filter the terms"
        placeholder="Filter the terms…"
        autocomplete="off"
        class="mb-4 w-full rounded-sm border border-stone-300 px-3.5 py-2.5 font-serif text-base placeholder:text-stone-400 focus:border-orange-600 focus:outline-none"
        data-print-hide
      />
      <p id="term-none" hidden class="mb-8 text-stone-500 italic">No term matches. Try the search page, which looks inside the chapters too.</p>

      <nav aria-label="Jump to a letter" class="mb-12 flex flex-wrap gap-x-3 gap-y-1 border-y border-stone-200 py-3 font-mono text-xs font-bold">
        {letters.map((letter) => <a href={`#letter-${letter}`} class="px-1 text-stone-500 hover:text-orange-600">{letter}</a>)}
      </nav>

      {
        letters.map((letter) => (
          <section class="mb-10" data-pagefind-body data-pagefind-meta="kind:Reference">
            <h2 id={`letter-${letter}`} class="micro-label mb-4 text-sm text-orange-600">{letter}</h2>
            <div>
              {entries
                .filter((e) => e.data.term[0].toUpperCase() === letter)
                .map((e) => {
                  const home = homes.get(e.id)!;
                  return (
                    <div class="entry border-b border-stone-100 py-4">
                      <h3 id={e.id} class="display text-lg">{e.data.term}</h3>
                      <p class="mt-1 text-base leading-relaxed text-stone-700">{e.data.definition}</p>
                      <p class="mt-1.5 font-sans text-xs text-stone-500" data-pagefind-ignore>
                        <a href={`${chapterUrl(home)}#term-${e.id}`} class="underline decoration-orange-300 underline-offset-2 hover:text-orange-700">
                          {chapterName(home)}
                        </a>
                        {e.data.seeAlso.filter((other) => homes.has(other)).length > 0 && (
                          <span>
                            {' · See also '}
                            {e.data.seeAlso.filter((other) => homes.has(other)).map((other, i) => (
                              <>
                                {i > 0 && ', '}
                                <a href={`#${other}`} class="underline decoration-stone-300 underline-offset-2 hover:text-orange-700">
                                  {(names.get(other) ?? other).toLowerCase()}
                                </a>
                              </>
                            ))}
                          </span>
                        )}
                      </p>
                    </div>
                  );
                })}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<script>
  const box = document.getElementById('term-filter') as HTMLInputElement | null;
  const none = document.getElementById('term-none');
  box?.addEventListener('input', () => {
    const q = box.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('.entry').forEach((entry) => {
      // Match on the term first, and on its definition for longer queries.
      const term = entry.querySelector('h3')?.textContent?.toLowerCase() ?? '';
      const hit = q === '' || term.includes(q) || (q.length > 3 && (entry.textContent ?? '').toLowerCase().includes(q));
      entry.hidden = !hit;
      if (hit) shown++;
    });
    document.querySelectorAll<HTMLElement>('section[data-pagefind-body]').forEach((s) => (s.hidden = s.querySelectorAll('.entry:not([hidden])').length === 0));
    if (none) none.hidden = shown > 0;
  });
</script>

<style>
  .entry:has(:target) {
    margin-inline: -0.75rem;
    padding-inline: 0.75rem;
    background: var(--accent-soft);
  }
</style>
