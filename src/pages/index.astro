---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { chapterUrl, getLectures, getParts, SITE_NAME } from '@/lib/book';

const lectures = await getLectures();
const parts = await getParts();
const firstReady = lectures.find((l) => l.data.status === 'ready' && l.data.part !== 'toolkit')
  ?? lectures.find((l) => l.data.status === 'ready');

const paths = [
  {
    title: 'New to machine learning',
    text: 'Start at chapter 1 and read in order. When a chapter leans on some mathematics, it names the toolkit chapter to open.',
    action: 'Begin with chapter 1',
    href: firstReady ? chapterUrl(firstReady) : '/',
  },
  {
    title: 'Here for neural networks',
    text: 'Read chapters 1 to 4 and chapter 6, then go straight to Part IV, which builds a network from nothing in eight chapters.',
    action: 'See Part IV',
    href: '/parts/networks/',
  },
  {
    title: 'Looking something up',
    text: 'Every term the book defines is in the glossary, with a link to the chapter that introduces it. Search covers every chapter.',
    action: 'Open the glossary',
    href: '/glossary/',
  },
];

const description =
  'A free, interactive online textbook that teaches machine learning from first principles: regression, classification, trees, neural networks and more, one idea at a time.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: SITE_NAME,
  description,
  inLanguage: 'en',
  genre: 'Educational',
  url: Astro.site?.href,
  isAccessibleForFree: true,
  bookEdition: 'First Edition, Volume I',
  about: ['Machine Learning', 'Statistics', 'Neural Networks'].map((name) => ({ '@type': 'Thing', name })),
};
---

<BaseLayout title={`${SITE_NAME} — A Free Interactive ML Textbook`} description={description} jsonLd={jsonLd} bar={false}>
  <main class="px-5 pt-14 pb-24 sm:px-6 sm:pt-20 sm:pb-32">
    <div class="mx-auto max-w-4xl">
      <header class="mb-16 text-center sm:mb-24">
        <div class="micro-label mb-6 tracking-[0.5em] text-orange-600">Volume I // First Edition</div>
        <h1 class="display mb-8 text-[clamp(2.6rem,12.5vw,3.75rem)] leading-[0.95] sm:mb-10 sm:text-7xl sm:leading-[0.9] md:text-8xl">
          The Book of <br />
          <span class="italic">Machine Learning.</span>
        </h1>
        <div class="mx-auto max-w-xl">
          <p class="mb-8 text-lg leading-relaxed font-light text-stone-500 italic sm:mb-10 sm:text-xl">
            Machine learning from first principles, one idea at a time. Every chapter starts with a question, works
            through a real example, and gives you something to try.
          </p>
          {
            firstReady && (
              <div class="flex justify-center gap-4">
                <a id="start-link" class="btn btn-primary" href={chapterUrl(firstReady)}>
                  <span id="start-text">Start Reading</span> <span aria-hidden="true">→</span>
                </a>
              </div>
              <p class="mt-6 font-sans text-xs text-stone-500">
                <a class="underline decoration-orange-300 underline-offset-4 hover:text-orange-700" href="/glossary/">Glossary</a>
                <span class="mx-2 text-stone-300" aria-hidden="true">/</span>
                <a class="underline decoration-orange-300 underline-offset-4 hover:text-orange-700" href="/notation/">Notation</a>
                <span class="mx-2 text-stone-300" aria-hidden="true">/</span>
                <a class="underline decoration-orange-300 underline-offset-4 hover:text-orange-700" href="/search/" data-open="search-window">Search</a>
                <span class="mx-2 text-stone-300" aria-hidden="true">/</span>
                <a class="underline decoration-orange-300 underline-offset-4 hover:text-orange-700" href="/map/">Map</a>
                <span class="mx-2 text-stone-300" aria-hidden="true">/</span>
                <a class="underline decoration-orange-300 underline-offset-4 hover:text-orange-700" href="/recap/">Recap</a>
              </p>
            )
          }
        </div>
      </header>

      <section aria-labelledby="paths" class="mb-16 sm:mb-24">
        <h2 id="paths" class="mb-6 border-b border-stone-200 pb-2 text-xs font-bold tracking-[0.2em] text-stone-900 uppercase">
          Where to start
        </h2>
        <div class="grid gap-x-10 gap-y-8 md:grid-cols-3">
          {
            paths.map((path) => (
              <div>
                <h3 class="display mb-2 text-lg">{path.title}</h3>
                <p class="mb-3 text-sm leading-7 text-stone-600">{path.text}</p>
                <a class="inline-block py-1.5 font-sans text-xs font-bold tracking-wider text-orange-700 uppercase hover:text-orange-900" href={path.href}>
                  {path.action} <span aria-hidden="true">→</span>
                </a>
              </div>
            ))
          }
        </div>
      </section>

      <div class="grid gap-12 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-4">
          <div class="md:sticky md:top-10">
          <h2 class="mb-6 border-b border-stone-200 pb-2 text-xs font-bold tracking-[0.2em] text-stone-900 uppercase">
            Preface
          </h2>
          <p class="text-sm leading-7 text-stone-500 italic">
            This book assumes you can read a little code and remember some school algebra. Nothing more. Each chapter
            teaches one idea, uses the same handful of small datasets, and puts the mathematics after the example
            rather than before it. Words with a dotted underline explain themselves when you point at them.
          </p>
          <p class="mt-4 text-sm leading-7 text-stone-500 italic">
            A chapter takes about a quarter of an hour to read, and longer if you play with the figures, which you
            should. Each one ends with exercises and their worked solutions.
          </p>

          <section aria-labelledby="progress-title" class="mt-8 rounded border border-stone-200 p-4 font-sans">
            <h2 id="progress-title" class="micro-label mb-2 text-stone-900">Your progress</h2>
            <div class="mb-3 h-1.5 overflow-hidden rounded-full bg-stone-100" aria-hidden="true">
              <div id="progress-bar" class="h-full w-0 rounded-full bg-orange-600 transition-[width] duration-500"></div>
            </div>
            <p id="progress-count" class="text-[13px] leading-relaxed text-stone-600">Nothing read yet. Chapters you finish are ticked in the contents.</p>
            <p class="mt-1 text-[13px]">
              <a id="review-link" hidden href="/review/" class="text-orange-700 underline decoration-orange-300 underline-offset-2 hover:text-orange-900"></a>
            </p>
            <p class="mt-3 text-[11px] leading-relaxed text-stone-400">Kept in this browser only. Save it to a file to carry it to another device.</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <button id="progress-export" type="button" class="btn btn-secondary btn-small">Save to a file</button>
              <label class="btn btn-secondary btn-small">
                Load a file
                <input id="progress-import" type="file" accept="application/json,.json" class="sr-only" />
              </label>
              <button id="progress-clear" type="button" hidden class="btn btn-small cursor-pointer text-stone-500 hover:text-red-600">Clear</button>
            </div>
          </section>
          </div>
        </div>

        <nav id="contents" class="md:col-span-8" aria-label="Table of contents">
          <h2 class="mb-6 border-b border-stone-200 pb-2 text-xs font-bold tracking-[0.2em] text-stone-900 uppercase">
            Table of Contents
          </h2>
          <div class="space-y-10">
            {
              parts.map((part) => (
                <section>
                  <h3 class="micro-label mb-1 tracking-widest text-orange-600">
                    <a href={`/parts/${part.id}/`} class="inline-block py-1.5 hover:text-orange-800">
                      {part.data.label}: {part.data.title} <span aria-hidden="true">›</span>
                    </a>
                  </h3>
                  <p class="mb-3 text-sm leading-6 text-stone-500">{part.data.intro.split('. ')[0].replace(/\.$/, '')}.</p>
                  <ol>
                    {lectures
                      .filter((l) => l.data.part === part.id)
                      .map((l) => {
                        const ready = l.data.status === 'ready';
                        const number = l.data.number.includes('.') ? l.data.number : l.data.number.padStart(2, '0');
                        const row = (
                          <>
                            <span class="flex items-baseline gap-3 sm:gap-6">
                              <span class="w-6 shrink-0 font-mono text-xs font-bold">{number}</span>
                              <span class:list={['display text-lg tracking-tight', !ready && 'text-stone-400']}>
                                <span class:list={[ready && 'toc-title']}>{l.data.title}</span>
                              </span>
                            </span>
                            <span class="flex items-center gap-3">
                              {ready && l.data.minutes && (
                                <span class="hidden font-mono text-[10px] text-stone-400 sm:inline">{l.data.minutes} min</span>
                              )}
                              <span class="toc-status w-10 text-right text-[9px] font-bold tracking-widest uppercase">
                                {ready ? 'Read' : 'Soon'}
                              </span>
                              <span aria-hidden="true" class={ready ? 'text-orange-600' : 'text-stone-200'}>
                                ›
                              </span>
                            </span>
                          </>
                        );
                        return (
                          <li class="border-b border-stone-100">
                            {ready ? (
                              <a
                                href={chapterUrl(l)}
                                data-chapter-id={l.id}
                                class="toc-row flex items-center justify-between gap-3 py-2.5 text-stone-900 transition-colors hover:text-orange-700"
                              >
                                {row}
                              </a>
                            ) : (
                              <span class="flex items-center justify-between py-2 text-stone-300">{row}</span>
                            )}
                          </li>
                        );
                      })}
                  </ol>
                </section>
              ))
            }
          </div>
        </nav>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { clearProgress, exportProgress, importProgress, loadProgress } from '@/lib/progress';

  // Show what this reader has finished, and offer to pick up where they stopped.
  const progress = loadProgress();
  const rows = [...document.querySelectorAll<HTMLAnchorElement>('a[data-chapter-id]')];
  let done = 0;
  for (const row of rows) {
    if (!progress.read[row.dataset.chapterId ?? '']) continue;
    done++;
    const status = row.querySelector('.toc-status');
    if (status) status.textContent = '✓ Done';
    row.classList.add('is-done');
  }

  const last = progress.last;
  const lastRow = last && rows.find((r) => r.dataset.chapterId === last.id);
  const start = document.getElementById('start-link') as HTMLAnchorElement | null;
  const startText = document.getElementById('start-text');
  if (last && lastRow && start && startText) {
    start.href = lastRow.href + (last.section ? `#${last.section}` : '');
    startText.textContent = `Continue: ${last.title}`;
  }

  const exercisesDone = Object.values(progress.exercises).reduce((sum, list) => sum + list.length, 0);
  const count = document.getElementById('progress-count');
  const fill = document.getElementById('progress-bar');
  if ((done > 0 || exercisesDone > 0) && count) {
    count.textContent =
      `${done} of ${rows.length} chapters finished` + (exercisesDone > 0 ? `, ${exercisesDone} ${exercisesDone === 1 ? 'exercise' : 'exercises'} done.` : '.');
  }
  if (fill) fill.style.width = `${(100 * done) / Math.max(1, rows.length)}%`;
  const toReview = Object.values(progress.missed).filter((m) => !m.resolved).length;
  const review = document.getElementById('review-link');
  if (toReview > 0 && review) {
    review.textContent = `${toReview} checkpoint ${toReview === 1 ? 'question' : 'questions'} to review →`;
    review.hidden = false;
  }

  const clear = document.getElementById('progress-clear');
  if (clear && (done > 0 || exercisesDone > 0 || last)) clear.hidden = false;
  clear?.addEventListener('click', () => {
    if (!confirm('Clear all reading progress saved in this browser?')) return;
    clearProgress();
    location.reload();
  });

  document.getElementById('progress-export')?.addEventListener('click', () => {
    const link = document.createElement('a');
    link.href = URL.createObjectURL(new Blob([exportProgress()], { type: 'application/json' }));
    link.download = 'book-of-ml-progress.json';
    link.click();
    URL.revokeObjectURL(link.href);
  });
  document.getElementById('progress-import')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    if (importProgress(await file.text())) location.reload();
    else alert('That file is not a progress file saved from this book.');
  });
</script>

<style>
  .toc-row.is-done .toc-status {
    color: var(--accent-dark);
  }
  .toc-row .toc-title {
    text-decoration: underline;
    text-decoration-color: #fdba74;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
</style>
