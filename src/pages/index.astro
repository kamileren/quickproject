---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroDemo from '@/components/figures/home/HeroDemo';
import { chapterUrl, getLectures, getParts, SITE_NAME } from '@/lib/book';

const lectures = await getLectures();
const parts = await getParts();
const firstReady = lectures.find((l) => l.data.status === 'ready' && l.data.part !== 'toolkit')
  ?? lectures.find((l) => l.data.status === 'ready');

const paths = [
  {
    title: 'New to machine learning',
    text: 'Start at chapter 1 and read in order. When a chapter leans on some mathematics, it names the toolkit chapter to open.',
    action: 'Begin with chapter 1',
    href: firstReady ? chapterUrl(firstReady) : '/',
  },
  {
    title: 'Here for neural networks',
    text: 'Read chapters 1 to 4 and chapter 6, then go straight to Part IV, which builds a network from nothing in eight chapters.',
    action: 'See Part IV',
    href: '/parts/networks/',
  },
  {
    title: 'Looking something up',
    text: 'Every term the book defines is in the glossary, with a link to the chapter that introduces it. Search covers every chapter.',
    action: 'Open the glossary',
    href: '/glossary/',
  },
];

const ready = lectures.filter((l) => l.data.status === 'ready');
const countIn = (tag: string) => ready.reduce((sum, l) => sum + ((l.body ?? '').match(new RegExp(`<${tag}[\\s>]`, 'g')) ?? []).length, 0);
const stats = [`${ready.length} chapters`, `${countIn('Figure')} interactive figures`.replace('interactive ', ''), `${countIn('Exercise')} exercises`, 'free'];

const quickLinks = [
  { label: 'Search', href: '/search/', open: 'search-window' },
  { label: 'Glossary', href: '/glossary/' },
  { label: 'Map', href: '/map/' },
  { label: 'Recap', href: '/recap/' },
];

// The small figures on the cover, each tied to the chapter it comes from. Unpublished chapters drop out.
const urlOf = (id: string) => {
  const found = ready.find((l) => l.id === id);
  return found && chapterUrl(found);
};
const demoUrls = { fit: urlOf('linear-regression'), cutoff: urlOf('what-is-learning'), neighbours: urlOf('nearest-neighbours'), step: urlOf('gradient-descent') };
const hasDemo = Object.values(demoUrls).some(Boolean);
// Which cover figure suits a reader who is part-way through a given chapter.
const demoFor = (l: (typeof lectures)[number]) => {
  const exact: Record<string, string> = { 'what-is-learning': 'cutoff', 'linear-regression': 'fit', 'gradient-descent': 'step', 'nearest-neighbours': 'neighbours', 'derivatives-and-gradients': 'step' };
  if (exact[l.id]) return exact[l.id];
  if (l.data.part === 'classification') return 'neighbours';
  if (l.data.part === 'networks') return 'step';
  return 'fit';
};
const demoByChapter = Object.fromEntries(ready.map((l) => [l.id, demoFor(l)]));
// One opening question is shown under the cover; the page script swaps in a different one on each visit.
const questions = ready.filter((l) => l.data.question).map((l) => ({ text: l.data.question, url: chapterUrl(l), label: l.data.number.includes('.') ? `Toolkit ${l.data.number}` : `Chapter ${l.data.number}` }));

const description =
  'A free, interactive textbook that teaches machine learning from first principles: regression, classification, trees and neural networks, one idea at a time.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: SITE_NAME,
  description,
  inLanguage: 'en',
  genre: 'Educational',
  url: Astro.site?.href,
  isAccessibleForFree: true,
  bookEdition: 'First Edition, Volume I',
  about: ['Machine Learning', 'Statistics', 'Neural Networks'].map((name) => ({ '@type': 'Thing', name })),
};
---

<BaseLayout title={`${SITE_NAME}: A Free Interactive Textbook`} description={description} jsonLd={jsonLd} bar={false}>
  <main class="relative px-5 pt-16 pb-20 sm:px-6 sm:pt-20 sm:pb-32">
    <div class="absolute top-2 right-2 flex font-sans text-stone-500 sm:top-4 sm:right-4" data-print-hide>
      <button type="button" data-open="settings-window" aria-label="Text size and colours" title="Text size and colours (t)" class="grid h-10 w-10 cursor-pointer place-items-center rounded font-serif text-base leading-none hover:bg-stone-100 hover:text-stone-900">
        <span aria-hidden="true">A<span class="text-xs">a</span></span>
      </button>
      <button type="button" data-open="menu-window" aria-label="Menu" title="Menu" class="grid h-10 w-10 cursor-pointer place-items-center rounded hover:bg-stone-100 hover:text-stone-900">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 5h12M3 9h12M3 13h12" /></svg>
      </button>
    </div>
    <div class="mx-auto max-w-4xl">
      <header class="mb-12 text-center sm:mb-24">
        <h1 class="display mb-8 text-[clamp(2.6rem,12.5vw,3.75rem)] leading-[0.95] sm:mb-10 sm:text-7xl sm:leading-[0.9] md:text-8xl">
          The Book of <br />
          <span class="italic">Machine Learning.</span>
        </h1>
        <div class="mx-auto max-w-xl">
          {/* Shown in place of the pitch to a reader who has been here before. Filled in by the page script. */}
          <a id="welcome-back" hidden href="/" class="mb-7 block rounded border-2 border-stone-900 p-5 text-left transition-colors hover:bg-stone-50 sm:mb-10">
            <span class="micro-label mb-2 block text-orange-700">Pick up where you stopped</span>
            <span id="welcome-title" class="display block text-2xl leading-tight"></span>
            <span id="welcome-detail" class="mt-1.5 block font-sans text-sm text-stone-600"></span>
            <span class="mt-4 block h-1.5 overflow-hidden rounded-full bg-stone-100" aria-hidden="true">
              <span id="welcome-bar" class="block h-full w-0 rounded-full bg-orange-600"></span>
            </span>
          </a>
          <p id="pitch" class="mb-7 text-[1.0625rem] leading-relaxed font-light text-stone-500 italic sm:mb-10 sm:text-xl">
            Machine learning from first principles, one idea at a time. Every chapter starts with a question, works
            through a real example, and gives you something to try.
          </p>
          {
            firstReady && (
              <div class="flex justify-center">
                <a id="start-link" class="btn btn-primary w-full justify-center py-3.5 text-[13px] sm:w-auto sm:py-2.5 sm:text-xs" href={chapterUrl(firstReady)}>
                  <span id="start-text">Start Reading</span> <span aria-hidden="true">→</span>
                </a>
              </div>
              <p class="mt-4 font-mono text-[10px] tracking-wider text-stone-500 uppercase">{stats.join(' · ')}</p>
              <nav aria-label="Reference pages" class="mt-7 flex justify-center gap-x-6 font-sans text-sm text-stone-600">
                {quickLinks.map((link) => (
                  <a href={link.href} data-open={link.open} class="py-1 underline decoration-orange-300 decoration-2 underline-offset-4 transition-colors hover:text-orange-700">
                    {link.label}
                  </a>
                ))}
              </nav>
            )
          }
        </div>

        {
          hasDemo && (
            <div class="mx-auto mt-10 max-w-xl rounded-sm border-2 border-stone-900 p-4 sm:mt-14 sm:p-6">
              <HeroDemo client:idle urls={demoUrls} byChapter={demoByChapter} />
            </div>
          )
        }

        {
          questions.length > 0 && (
            <p class="mx-auto mt-10 max-w-xl text-center sm:mt-14">
              <span class="micro-label mb-2 block text-stone-500">A question from the book</span>
              <a id="teaser" href={questions[0].url} class="group block" data-questions={JSON.stringify(questions)}>
                <span id="teaser-text" class="block text-xl leading-snug text-stone-800 italic group-hover:text-orange-800 sm:text-2xl">“{questions[0].text}”</span>
                <span id="teaser-label" class="mt-2 inline-block font-sans text-xs font-bold tracking-wider text-orange-700 uppercase">{questions[0].label} →</span>
              </a>
            </p>
          )
        }
      </header>

      <section aria-labelledby="paths" class="mb-12 sm:mb-24">
        <h2 id="paths" class="mb-6 border-b border-stone-200 pb-2 text-xs font-bold tracking-[0.2em] text-stone-900 uppercase">
          Where to start
        </h2>
        <div class="path-row -mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2 md:mx-0 md:grid md:grid-cols-3 md:gap-x-10 md:overflow-visible md:px-0 md:pb-0">
          {
            paths.map((path) => (
              <a href={path.href} class="path-card group block w-[80%] shrink-0 snap-center rounded border border-stone-200 p-4 transition-colors hover:border-stone-900 md:w-auto md:border-0 md:p-0">
                <h3 class="display mb-1.5 text-lg md:mb-2">{path.title}</h3>
                <p class="mb-2 text-sm leading-6 text-stone-600 md:mb-3 md:leading-7">{path.text}</p>
                <span class="inline-block font-sans text-xs font-bold tracking-wider text-orange-700 uppercase group-hover:text-orange-900">
                  {path.action} <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
        <div id="path-dots" class="mt-3 flex justify-center gap-1.5 md:hidden" aria-hidden="true">
          {paths.map((_, i) => <span class:list={['h-1.5 w-1.5 rounded-full bg-stone-300 transition-colors', i === 0 && 'is-on']} />)}
        </div>
      </section>

      <div class="grid gap-10 md:grid-cols-12 md:gap-16">
        <div class="max-md:contents md:col-span-4">
          <div class="max-md:contents md:sticky md:top-10">
          <div class="max-md:order-3">
          <h2 class="mb-6 border-b border-stone-200 pb-2 text-xs font-bold tracking-[0.2em] text-stone-900 uppercase">
            Preface
          </h2>
          <p class="text-sm leading-7 text-stone-500 italic">
            This book assumes you can read a little code and remember some school algebra. Nothing more. Each chapter
            teaches one idea, uses the same handful of small datasets, and puts the mathematics after the example
            rather than before it. Words with a dotted underline explain themselves when you point at them.
          </p>
          <p class="mt-4 text-sm leading-7 text-stone-500 italic">
            A chapter takes about a quarter of an hour to read, and longer if you play with the figures, which you
            should. Each one ends with exercises and their worked solutions.
          </p>
          </div>

          <section id="progress-panel" hidden aria-labelledby="progress-title" class="rounded border border-stone-200 p-4 font-sans max-md:order-1 md:mt-8">
            <h2 id="progress-title" class="micro-label mb-2 text-stone-900">Your progress</h2>
            <div class="mb-3 h-1.5 overflow-hidden rounded-full bg-stone-100" aria-hidden="true">
              <div id="progress-bar" class="h-full w-0 rounded-full bg-orange-600 transition-[width] duration-500"></div>
            </div>
            <p id="progress-count" class="text-[13px] leading-relaxed text-stone-600"></p>
            <p id="progress-checkpoints" hidden class="text-[13px] leading-relaxed text-stone-600"></p>
            <p class="mt-1 text-[13px]">
              <a id="review-link" hidden href="/review/" class="text-orange-700 underline decoration-orange-300 underline-offset-2 hover:text-orange-900"></a>
            </p>
            <p class="mt-3 text-[11px] leading-relaxed text-stone-500">
              Remembered by this browser, on this device.{' '}
              <button id="progress-clear" type="button" class="cursor-pointer underline decoration-stone-300 underline-offset-2 hover:text-red-600">Clear it</button>
            </p>
          </section>
          </div>
        </div>

        <nav id="contents" class="max-md:order-2 md:col-span-8" aria-label="Table of contents">
          <h2 class="mb-6 border-b border-stone-200 pb-2 text-xs font-bold tracking-[0.2em] text-stone-900 uppercase">
            Table of Contents
          </h2>
          <div class="space-y-8 sm:space-y-10">
            {
              parts.map((part) => {
                const own = lectures.filter((l) => l.data.part === part.id);
                const published = own.filter((l) => l.data.status === 'ready').length;
                const rows = (
                  <ol>
                    {own.map((l) => {
                      const isReady = l.data.status === 'ready';
                      const number = l.data.number.includes('.') ? l.data.number : l.data.number.padStart(2, '0');
                      const row = (
                        <>
                          <span class="flex min-w-0 items-baseline gap-3 sm:gap-6">
                            <span class="w-6 shrink-0 font-mono text-xs font-bold">{number}</span>
                            <span class:list={['display text-[1.0625rem] leading-snug tracking-tight sm:text-lg', !isReady && 'text-stone-400']}>
                              <span class:list={[isReady && 'toc-title']}>{l.data.title}</span>
                            </span>
                          </span>
                          <span class="flex shrink-0 items-center gap-2 sm:gap-3">
                            {isReady && l.data.minutes && <span class="toc-min font-mono text-[10px] text-stone-500">{l.data.minutes} min</span>}
                            <span class="toc-status text-right text-[9px] font-bold tracking-widest uppercase sm:w-10">{isReady ? 'Read' : 'Soon'}</span>
                            <span aria-hidden="true" class={isReady ? 'text-orange-600' : 'text-stone-200'}>
                              ›
                            </span>
                          </span>
                        </>
                      );
                      return (
                        <li class="border-b border-stone-100">
                          {isReady ? (
                            <a
                              href={chapterUrl(l)}
                              data-chapter-id={l.id}
                              data-minutes={l.data.minutes}
                              class="toc-row flex items-center justify-between gap-3 py-3 text-stone-900 transition-colors hover:text-orange-700 sm:py-2.5"
                            >
                              {row}
                            </a>
                          ) : (
                            <span class="toc-row is-draft flex items-center justify-between gap-3 py-2 text-stone-300">{row}</span>
                          )}
                        </li>
                      );
                    })}
                  </ol>
                );
                const heading = (
                  <>
                    {part.data.label}: {part.data.title}
                  </>
                );
                return published === 0 ? (
                  <details class="fold toc-later border-b border-stone-100 pb-2">
                    <summary class="micro-label py-2 tracking-widest text-stone-500">
                      <span class="flex-1">{heading}</span>
                      <span class="font-normal tracking-wider">{own.length} chapters, coming soon</span>
                    </summary>
                    <p class="mt-2 mb-2 text-sm leading-6 text-stone-500">{part.data.intro.split('. ')[0].replace(/\.$/, '')}.</p>
                    {rows}
                  </details>
                ) : (
                  <section data-part>
                    <h3 class="micro-label mb-1 flex items-baseline justify-between gap-3 tracking-widest text-orange-600">
                      <a href={`/parts/${part.id}/`} class="inline-block py-1.5 hover:text-orange-800">
                        {heading} <span aria-hidden="true">›</span>
                      </a>
                      <span data-part-count class="shrink-0 font-normal tracking-wider text-stone-500">
                        {published === own.length ? `${own.length} chapters` : `${published} of ${own.length} out`}
                      </span>
                    </h3>
                    <p class="mb-2 text-sm leading-6 text-stone-500">{part.data.intro.split('. ')[0].replace(/\.$/, '')}.</p>
                    {rows}
                  </section>
                );
              })
            }
          </div>
        </nav>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { clearProgress, loadProgress, paced, readerPace } from '@/lib/progress';

  // Show what this reader has finished, and offer to pick up where they stopped.
  const progress = loadProgress();
  const rows = [...document.querySelectorAll<HTMLAnchorElement>('a[data-chapter-id]')];

  // Reading times follow the reader's own pace once there are finished chapters to judge by.
  const pace = readerPace(progress);
  if (Math.abs(pace - 1) >= 0.15) {
    for (const row of rows) {
      const label = row.querySelector('.toc-min');
      const minutes = Number(row.dataset.minutes ?? 0);
      if (label && minutes > 0) label.textContent = `${paced(minutes, pace)} min`;
    }
  }
  let done = 0;
  for (const row of rows) {
    if (!progress.read[row.dataset.chapterId ?? '']) continue;
    done++;
    const status = row.querySelector('.toc-status');
    if (status) status.textContent = '✓ Done';
    row.classList.add('is-done');
  }

  document.querySelectorAll<HTMLElement>('[data-part]').forEach((part) => {
    const all = part.querySelectorAll('a[data-chapter-id]').length;
    const finished = part.querySelectorAll('.toc-row.is-done').length;
    const label = part.querySelector('[data-part-count]');
    if (label && finished > 0) {
      label.textContent = finished === all ? '✓ all read' : `${finished} of ${all} read`;
      label.classList.add('text-orange-700');
    }
  });

  // The row of starting points: mark which card is in view.
  const pathRow = document.querySelector<HTMLElement>('.path-row');
  const dots = [...document.querySelectorAll<HTMLElement>('#path-dots span')];
  pathRow?.addEventListener(
    'scroll',
    () => {
      const cards = [...pathRow.children] as HTMLElement[];
      const middle = pathRow.scrollLeft + pathRow.clientWidth / 2;
      const nearest = cards.reduce((best, card, i) => (Math.abs(card.offsetLeft + card.offsetWidth / 2 - middle) < Math.abs(cards[best].offsetLeft + cards[best].offsetWidth / 2 - middle) ? i : best), 0);
      dots.forEach((d, i) => d.classList.toggle('is-on', i === nearest));
    },
    { passive: true },
  );

  // A different question from the book on each visit.
  const teaser = document.getElementById('teaser') as HTMLAnchorElement | null;
  if (teaser) {
    const all = JSON.parse(teaser.dataset.questions ?? '[]') as { text: string; url: string; label: string }[];
    // Prefer chapters the reader has not finished.
    const fresh = all.filter((q) => !progress.read[q.url.replace(/\//g, '')]);
    const pool = fresh.length > 0 ? fresh : all;
    const pick = pool[Math.floor(Math.random() * pool.length)];
    if (pick) {
      teaser.href = pick.url;
      document.getElementById('teaser-text')!.textContent = `“${pick.text}”`;
      document.getElementById('teaser-label')!.textContent = `${pick.label} →`;
    }
  }

  const last = progress.last;
  const lastRow = last && rows.find((r) => r.dataset.chapterId === last.id);
  const start = document.getElementById('start-link') as HTMLAnchorElement | null;
  const startText = document.getElementById('start-text');
  if (last && lastRow && start && startText) {
    const resume = lastRow.href + (last.section ? `#${last.section}` : '');
    start.href = resume;

    // Returning readers get their place in the book instead of the pitch.
    const welcome = document.getElementById('welcome-back') as HTMLAnchorElement | null;
    const finished = Boolean(progress.read[last.id]);
    if (welcome && !finished) {
      const minutes = Number(lastRow.dataset.minutes ?? 0);
      const left = minutes > 0 ? paced(minutes * (1 - (last.fraction ?? 0)), pace) : 0;
      welcome.href = resume;
      document.getElementById('welcome-title')!.textContent = `${last.label}: ${last.title}`;
      document.getElementById('welcome-detail')!.textContent =
        (last.sectionTitle ? `You were at “${last.sectionTitle}”` : 'You had just started') + (left > 0 ? `, about ${left} min left.` : '.');
      document.getElementById('welcome-bar')!.style.width = `${Math.round(100 * (last.fraction ?? 0))}%`;
      welcome.hidden = false;
      document.getElementById('pitch')?.setAttribute('hidden', '');
    }
    startText.textContent = `Continue: ${last.title}`;
  }

  const exercisesDone = Object.values(progress.exercises).reduce((sum, list) => sum + list.length, 0);
  const count = document.getElementById('progress-count');
  const fill = document.getElementById('progress-bar');
  const panel = document.getElementById('progress-panel');
  if (panel && (done > 0 || exercisesDone > 0)) panel.hidden = false;
  if ((done > 0 || exercisesDone > 0) && count) {
    count.textContent =
      `${done} of ${rows.length} chapters finished` + (exercisesDone > 0 ? `, ${exercisesDone} ${exercisesDone === 1 ? 'exercise' : 'exercises'} done.` : '.');
  }
  if (fill) fill.style.width = `${(100 * done) / Math.max(1, rows.length)}%`;

  // Checkpoints: how many were right on the first try.
  const answered = Object.values(progress.answers).reduce((sum, a) => sum + Object.keys(a).length, 0);
  const missedEver = Object.keys(progress.missed).length;
  const checkpoints = document.getElementById('progress-checkpoints');
  if (checkpoints && answered > 0) {
    checkpoints.textContent = `${Math.max(0, answered - missedEver)} of ${answered} checkpoints right first time.`;
    checkpoints.hidden = false;
    if (panel) panel.hidden = false;
  }
  const toReview = Object.values(progress.missed).filter((m) => !m.resolved).length;
  const review = document.getElementById('review-link');
  if (toReview > 0 && review) {
    review.textContent = `${toReview} checkpoint ${toReview === 1 ? 'question' : 'questions'} to review →`;
    review.hidden = false;
    if (panel) panel.hidden = false;
  }

  document.getElementById('progress-clear')?.addEventListener('click', () => {
    if (!confirm('Clear all reading progress remembered by this browser?')) return;
    clearProgress();
    location.reload();
  });
</script>

<style>
  .toc-row.is-done .toc-status {
    color: var(--accent-dark);
  }
  /* On a phone a row shows its reading time; once finished, it shows the tick. */
  @media (max-width: 639px) {
    .toc-row:not(.is-done):not(.is-draft) .toc-status,
    .toc-row.is-done .toc-min {
      display: none;
    }
  }
  /* The row of starting points scrolls sideways on a phone, without a visible scrollbar. */
  .path-row {
    scrollbar-width: none;
  }
  .path-row::-webkit-scrollbar {
    display: none;
  }
  #path-dots .is-on {
    background: var(--ink);
  }
  .toc-later > summary::before {
    color: var(--faint);
  }
  .toc-row .toc-title {
    text-decoration: underline;
    text-decoration-color: #fdba74;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
</style>
