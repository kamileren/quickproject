---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchBox from '@/components/SearchBox.astro';
import { SITE_NAME } from '@/lib/book';
---

<BaseLayout current="search" title={`Search — ${SITE_NAME}`} description="Search every chapter of the book and the glossary." noindex searchWindow={false}>
  <main class="px-5 pt-10 pb-24 sm:px-6 sm:pt-14 sm:pb-32">
    <div class="mx-auto max-w-3xl">
      <header class="mb-8">
        <div class="mb-8 flex items-center gap-4">
          <div class="h-[2px] w-12 bg-stone-900"></div>
          <div class="micro-label text-[11px] tracking-[0.4em] text-stone-900">Reference</div>
        </div>
        <h1 class="display text-5xl leading-[1.05] sm:text-6xl">Search.</h1>
      </header>

      <SearchBox syncUrl />

      <noscript>
        <p class="text-stone-600">Search needs JavaScript. The <a class="underline" href="/#contents">table of contents</a> and the <a class="underline" href="/glossary/">glossary</a> work without it.</p>
      </noscript>
    </div>
  </main>
</BaseLayout>
