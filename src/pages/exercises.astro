---
/** Every chapter's exercises on one page. Hints and worked solutions stay in the chapters. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { chapterLabel, chapterUrl, getParts, getReadyLectures, SITE_NAME } from '@/lib/book';
import { exercises, renderMarkdown } from '@/lib/recap';

const parts = await getParts();
const lectures = await getReadyLectures();

const chapters = (
  await Promise.all(
    lectures.map(async (lecture) => ({
      lecture,
      items: await Promise.all(exercises(lecture.body ?? '').map(async (e) => ({ kind: e.kind, html: await renderMarkdown(e.question) }))),
    })),
  )
).filter((c) => c.items.length > 0);

const total = chapters.reduce((sum, c) => sum + c.items.length, 0);
const kinds = ['by hand', 'with the figure', 'in code', 'think'].filter((k) => chapters.some((c) => c.items.some((i) => i.kind === k)));
const description = `${total} machine learning exercises with worked solutions, from regression to neural networks: by hand, with interactive figures and in Python.`;
---

<BaseLayout title={`Machine Learning Exercises with Solutions — ${SITE_NAME}`} description={description}>
  <main class="px-5 pt-10 pb-24 sm:px-6 sm:pt-14 sm:pb-32">
    <div class="mx-auto max-w-3xl">
      <header class="mb-12">
        <div class="mb-8 flex items-center gap-4">
          <div class="h-[2px] w-12 bg-stone-900"></div>
          <div class="micro-label text-[11px] tracking-[0.4em] text-stone-900">Practice</div>
        </div>
        <h1 class="display mb-6 text-5xl leading-[1.05] sm:text-6xl">Exercises.</h1>
        <p class="max-w-2xl text-xl leading-relaxed font-light text-stone-500 italic">
          All {total} exercises in the book, chapter by chapter. Each one has a hint and a worked solution at the end of its chapter.
        </p>
        <fieldset class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 font-sans text-sm text-stone-600" data-print-hide>
          <legend class="sr-only">Show exercises of these kinds</legend>
          {
            kinds.map((k) => (
              <label class="flex cursor-pointer items-center gap-2">
                <input type="checkbox" class="kind-filter h-4 w-4 accent-orange-600" value={k} checked /> {k}
              </label>
            ))
          }
        </fieldset>
      </header>

      {
        parts.map((part) => {
          const own = chapters.filter((c) => c.lecture.data.part === part.id);
          return (
            own.length > 0 && (
              <section class="mb-14">
                <h2 class="micro-label mb-5 text-sm text-orange-600">
                  {part.data.label}: {part.data.title}
                </h2>
                {own.map(({ lecture, items }) => (
                  <article class="ex-chapter mb-10">
                    <div class="micro-label mb-1 text-stone-500">{chapterLabel(lecture.data.number)}</div>
                    <h3 class="display mb-4 text-xl">
                      <a href={chapterUrl(lecture)} class="underline decoration-orange-300 decoration-2 underline-offset-4 hover:text-orange-700">
                        {lecture.data.title}
                      </a>
                    </h3>
                    <ol class="space-y-4">
                      {items.map((item) => (
                        <li class="ex-item rounded border border-stone-200 p-4 sm:p-5" data-kind={item.kind}>
                          <div class="micro-label mb-2 font-normal tracking-widest text-stone-500">{item.kind}</div>
                          <div class="ex-question text-base leading-relaxed text-stone-800" set:html={item.html} />
                        </li>
                      ))}
                    </ol>
                    <a href={`${chapterUrl(lecture)}#exercises`} class="mt-3 inline-block font-sans text-sm text-orange-700 hover:underline">
                      Hints and worked solutions in {chapterLabel(lecture.data.number).toLowerCase()} →
                    </a>
                  </article>
                ))}
              </section>
            )
          );
        })
      }
    </div>
  </main>
</BaseLayout>

<style is:global>
  .ex-question p + p,
  .ex-question p + ul,
  .ex-question p + ol {
    margin-top: 0.75rem;
  }
  .ex-question ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .ex-question ol {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  @media print {
    .ex-item {
      break-inside: avoid;
    }
  }
</style>

<script>
  const boxes = [...document.querySelectorAll<HTMLInputElement>('.kind-filter')];
  const apply = () => {
    const shown = new Set(boxes.filter((b) => b.checked).map((b) => b.value));
    document.querySelectorAll<HTMLElement>('.ex-chapter').forEach((chapter) => {
      let visible = 0;
      chapter.querySelectorAll<HTMLElement>('.ex-item').forEach((item) => {
        item.hidden = !shown.has(item.dataset.kind ?? '');
        if (!item.hidden) visible++;
      });
      chapter.hidden = visible === 0;
    });
  };
  boxes.forEach((b) => b.addEventListener('change', apply));
</script>
