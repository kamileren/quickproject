---
/**
 * How the chapters depend on each other.
 *
 * The chapters are listed in reading order with their titles. Lines are only
 * drawn for the chapter the reader picks: what it needs (and what those need
 * in turn), and what it leads to. Drawing every dependency at once made a
 * tangle that nobody could read.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { chapterLabel, chapterUrl, getLectures, getParts, SITE_NAME } from '@/lib/book';

const parts = await getParts();
const lectures = await getLectures();
const byId = new Map(lectures.map((l) => [l.id, l]));

/** Everything a chapter rests on, directly or through other chapters. */
function allNeeds(id: string, seen = new Set<string>()): Set<string> {
  for (const need of byId.get(id)?.data.prerequisites ?? []) {
    if (seen.has(need) || !byId.has(need)) continue;
    seen.add(need);
    allNeeds(need, seen);
  }
  return seen;
}

const details = Object.fromEntries(
  lectures.map((l) => {
    const needs = allNeeds(l.id);
    return [
      l.id,
      {
        label: chapterLabel(l.data.number),
        title: l.data.title,
        text: l.data.question ?? l.data.summary,
        ready: l.data.status === 'ready',
        url: chapterUrl(l),
        minutes: l.data.minutes ?? 0,
        needs: l.data.prerequisites.filter((id) => byId.has(id)),
        // In book order, so it reads as a route.
        path: lectures.filter((x) => needs.has(x.id)).map((x) => x.id),
        leads: lectures.filter((x) => x.data.prerequisites.includes(l.id)).map((x) => x.id),
      },
    ];
  }),
);
const description = 'How the chapters of the book build on one another. Pick a chapter to see what to read first.';
---

<BaseLayout title={`Map — ${SITE_NAME}`} description={description}>
  <main class="px-5 pt-10 pb-24 sm:px-6 sm:pt-14 sm:pb-32">
    <div class="mx-auto max-w-4xl">
      <header class="mb-10">
        <div class="mb-8 flex items-center gap-4">
          <div class="h-[2px] w-12 bg-stone-900"></div>
          <div class="micro-label text-[11px] tracking-[0.4em] text-stone-900">Reference</div>
        </div>
        <h1 class="display mb-6 text-5xl leading-[1.05] sm:text-6xl">Map.</h1>
        <p class="max-w-2xl text-xl leading-relaxed font-light text-stone-500 italic">
          The chapters in reading order. Pick one to see what it builds on and what it opens up.
        </p>
        <p class="mt-3 hidden font-sans text-xs text-stone-500 md:block">
          With the keyboard: <kbd class="map-key">↑</kbd> <kbd class="map-key">↓</kbd> to move, <kbd class="map-key">Enter</kbd> twice to open.
        </p>
      </header>

      <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_19rem] md:gap-12">
        <div id="book-map" class="relative">
          <svg id="map-lines" class="pointer-events-none absolute inset-0 h-full w-full overflow-visible" aria-hidden="true"></svg>
          {
            parts.map((part) => (
              <section class="mb-7">
                <h2 class="micro-label mb-1 pl-[4rem] text-orange-700">
                  {part.data.label} · {part.data.title}
                </h2>
                <ol>
                  {lectures
                    .filter((l) => l.data.part === part.id)
                    .map((l) => (
                      <li>
                        <button type="button" class:list={['map-row', l.data.status !== 'ready' && 'is-draft']} data-id={l.id} aria-pressed="false">
                          <span class="map-dot" aria-hidden="true" />
                          <span class="map-number">{l.data.number}</span>
                          <span class="map-title">{l.data.title}</span>
                          <span class="map-state" />
                        </button>
                      </li>
                    ))}
                </ol>
              </section>
            ))
          }
        </div>

        <aside>
          <section id="map-detail" aria-live="polite" class="fixed inset-x-3 bottom-3 z-20 hidden rounded border-2 border-stone-900 bg-white p-4 shadow-2xl md:sticky md:inset-x-auto md:top-20 md:bottom-auto md:block md:p-5 md:shadow-none">
            <p class="text-stone-500 italic">Pick a chapter.</p>
          </section>
          <div class="mt-6 hidden space-y-1.5 font-mono text-[11px] text-stone-500 md:block">
            <p><span class="legend-line bg-orange-600"></span>Read first</p>
            <p><span class="legend-line bg-stone-900"></span>Comes next</p>
            <p><span class="mr-2 inline-block h-2.5 w-2.5 rounded-full bg-orange-600 align-[-1px]"></span>You have finished it</p>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <script is:inline type="application/json" id="map-data" set:html={JSON.stringify(details)} />
</BaseLayout>

<style is:global>
  /* One row per chapter: a dot on the left, the number, the title. */
  #book-map .map-row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1.75rem minmax(0, 1fr) auto;
    column-gap: 0.5rem;
    align-items: center;
    width: 100%;
    padding: 0.5rem 0.6rem 0.5rem 0;
    border-radius: 0.25rem;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.12s, opacity 0.15s;
  }
  #book-map .map-row:hover {
    background: var(--wash);
  }
  #book-map .map-dot {
    justify-self: end;
    margin-right: 0.9rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--ink);
    border-radius: 9999px;
    background: #fff;
  }
  #book-map .map-number {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--muted);
  }
  #book-map .map-title {
    font-family: Georgia, serif;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
  }
  #book-map .map-state {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  #book-map .map-row.is-draft .map-title {
    font-weight: 400;
    color: var(--muted);
  }
  #book-map .map-row.is-draft .map-dot {
    border-color: var(--faint);
    border-style: dashed;
  }
  #book-map .map-row.is-done .map-dot {
    border-color: var(--accent);
    background: var(--accent);
  }

  /* With a chapter picked, everything unrelated steps back. */
  #book-map.has-pick .map-row {
    opacity: 0.4;
  }
  #book-map.has-pick .map-row:is(.is-picked, .is-needed, .is-path, .is-lead, :hover, :focus-visible) {
    opacity: 1;
  }
  #book-map .map-row.is-picked {
    background: var(--ink);
  }
  #book-map .map-row.is-picked :is(.map-title, .map-number, .map-state) {
    color: #fff;
  }
  #book-map .map-row.is-picked .map-dot {
    border-color: #fff;
  }
  #book-map .map-row.is-needed .map-dot {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  #book-map .map-row:is(.is-needed, .is-path) .map-state {
    color: var(--accent-dark);
  }

  #map-lines path {
    fill: none;
    stroke-linecap: round;
  }
  #map-lines .needs {
    stroke: var(--accent);
    stroke-width: 2.5;
  }
  #map-lines .leads {
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .map-key {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--rule);
    border-radius: 0.2rem;
    background: var(--wash);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink);
  }
  #book-map .map-row:focus-visible {
    outline-offset: -2px;
  }
  .legend-line {
    display: inline-block;
    width: 1.25rem;
    height: 2px;
    margin-right: 0.5rem;
    vertical-align: middle;
  }
</style>

<script>
  import { loadProgress, paced, readerPace } from '@/lib/progress';

  interface Detail {
    label: string;
    title: string;
    text: string;
    ready: boolean;
    url: string;
    minutes: number;
    needs: string[];
    path: string[];
    leads: string[];
  }
  const data = JSON.parse(document.getElementById('map-data')?.textContent ?? '{}') as Record<string, Detail>;
  const map = document.getElementById('book-map')!;
  const lines = document.getElementById('map-lines')!;
  const panel = document.getElementById('map-detail')!;
  const progress = loadProgress();
  const read = progress.read;
  const pace = readerPace(progress);
  const rows = new Map([...map.querySelectorAll<HTMLButtonElement>('.map-row')].map((r) => [r.dataset.id ?? '', r]));

  const baseState = (id: string) => (read[id] ? '✓' : data[id]?.ready ? '' : 'Soon');
  for (const [id, row] of rows) row.classList.toggle('is-done', Boolean(read[id]));

  const el = (tag: string, className: string, text?: string) => {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  /** Where the dot of a chapter's row sits, measured inside the map. */
  function dotAt(id: string): { x: number; y: number } | null {
    const dot = rows.get(id)?.querySelector('.map-dot');
    if (!dot) return null;
    const box = dot.getBoundingClientRect();
    const frame = map.getBoundingClientRect();
    return { x: box.left - frame.left + box.width / 2, y: box.top - frame.top + box.height / 2 };
  }

  /** A curve between two dots that bows out to the left, further for longer jumps. */
  function arc(from: string, to: string, kind: string): SVGPathElement | null {
    const a = dotAt(from);
    const b = dotAt(to);
    if (!a || !b) return null;
    const bow = Math.min(a.x - 12, 12 + Math.abs(b.y - a.y) * 0.07);
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', `M${a.x - 7},${a.y} C${a.x - 7 - bow},${a.y} ${b.x - 7 - bow},${b.y} ${b.x - 7},${b.y}`);
    path.setAttribute('class', kind);
    return path;
  }

  let picked: string | undefined;

  function draw(): void {
    lines.replaceChildren();
    const d = picked ? data[picked] : undefined;
    const direct = new Set(d?.needs ?? []);
    if (picked && d) {
      const drawn: (SVGPathElement | null)[] = [];
      // Only the direct links are drawn. Chapters further back are marked on their rows instead.
      for (const need of d.needs) drawn.push(arc(need, picked, 'needs'));
      for (const lead of d.leads) drawn.push(arc(picked, lead, 'leads'));
      lines.append(...drawn.filter((p): p is SVGPathElement => p !== null));
    }
    for (const [id, row] of rows) {
      const isDirect = direct.has(id);
      const onPath = Boolean(d?.path.includes(id)) && !isDirect;
      row.classList.toggle('is-picked', id === picked);
      row.classList.toggle('is-needed', isDirect);
      row.classList.toggle('is-path', onPath);
      row.classList.toggle('is-lead', Boolean(d?.leads.includes(id)));
      row.setAttribute('aria-pressed', String(id === picked));
      // The word at the end of a row says how it relates to the picked chapter.
      const role = isDirect ? 'Read first' : onPath ? 'Before that' : d?.leads.includes(id) ? 'Next' : '';
      row.querySelector('.map-state')!.textContent = [role, baseState(id)].filter(Boolean).join(' ');
    }
  }

  function pick(id: string): void {
    const d = data[id];
    if (!d) return;
    picked = id;
    map.classList.add('has-pick');
    draw();

    const titles = (ids: string[]) => ids.map((x) => data[x].title).join(', ');
    const unread = d.path.filter((x) => !read[x] && data[x].ready);
    const minutes = paced(unread.reduce((sum, x) => sum + data[x].minutes, 0), pace);
    const parts = [
      el('div', 'micro-label mb-1 text-orange-700', d.label + (read[id] ? ' · finished' : '')),
      el('h2', 'display text-xl leading-snug', d.title),
      el('p', 'mt-2 hidden text-[15px] leading-relaxed text-stone-600 italic md:block', d.text),
    ];
    const facts = el('dl', 'mt-3 space-y-2 font-sans text-[13px] leading-snug text-stone-700');
    const fact = (name: string, value: string, phone = true) => {
      const row = el('div', phone ? '' : 'hidden md:block');
      row.append(el('dt', 'micro-label mb-0.5 text-stone-500', name), el('dd', '', value));
      facts.append(row);
    };
    fact('Builds on', d.needs.length > 0 ? titles(d.needs) : 'Nothing. You can start here.');
    if (d.path.length > 0) {
      fact('Still to read first', unread.length === 0 ? 'Nothing. You are ready for it.' : `${unread.length} of the ${d.path.length} before it, about ${minutes} min`);
    }
    if (d.leads.length > 0) fact('Leads to', titles(d.leads), false);
    parts.push(facts);
    // With chapters still to read on the way, the main button starts the route; the chapter itself is second.
    const first = unread[0];
    if (first) {
      const route = el('a', 'btn btn-primary mt-4 w-full justify-center text-center', `Start the route: ${data[first].title} →`) as HTMLAnchorElement;
      route.href = data[first].url;
      parts.push(route);
    }
    if (d.ready) {
      const link = el('a', first ? 'btn btn-secondary mt-2 w-full justify-center' : 'btn btn-primary mt-4 w-full justify-center', first ? 'Open this chapter anyway' : 'Open the chapter →') as HTMLAnchorElement;
      link.href = d.url;
      parts.push(link);
    } else {
      parts.push(el('p', 'mt-4 font-mono text-[11px] tracking-widest text-stone-500 uppercase', 'Coming soon'));
    }
    // On a phone the card floats over the list, so it needs a way to be put away.
    const close = el('button', 'micro-label absolute top-2 right-2 cursor-pointer p-2 text-stone-500 md:hidden', 'Close') as HTMLButtonElement;
    close.type = 'button';
    close.addEventListener('click', () => {
      panel.classList.add('hidden');
      picked = undefined;
      map.classList.remove('has-pick');
      draw();
    });
    panel.replaceChildren(close, ...parts);
    panel.classList.remove('hidden');
  }

  const order = [...rows.keys()];
  for (const [id, row] of rows) {
    row.addEventListener('click', () => {
      // A second press on the picked chapter opens it.
      if (picked === id && data[id].ready && matchMedia('(min-width: 768px)').matches) location.href = data[id].url;
      else pick(id);
    });
    // Arrow keys walk the list and pick as they go; Home and End jump to the ends.
    row.addEventListener('keydown', (e) => {
      const at = order.indexOf(id);
      const to = e.key === 'ArrowDown' ? at + 1 : e.key === 'ArrowUp' ? at - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? order.length - 1 : -1;
      const target = rows.get(order[to]);
      if (!target) return;
      e.preventDefault();
      target.focus();
      pick(order[to]);
    });
  }
  // The curves follow the rows when the page reflows.
  addEventListener('resize', draw);
  draw();

  // Start on the chapter the reader had open, or failing that the first one they have not finished.
  const start = progress.last?.id ?? [...rows.keys()].find((id) => data[id].ready && !read[id]);
  if (start && data[start] && matchMedia('(min-width: 768px)').matches) pick(start);
</script>
