---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteNav from '@/components/SiteNav.astro';
import { SITE_NAME } from '@/lib/book';

// Kept in the order of the file, which follows the order the book introduces them.
const symbols = await getCollection('notation');
const description = 'Every symbol the book uses and what it stands for, in one table.';
---

<BaseLayout title={`Notation — ${SITE_NAME}`} description={description}>
  <main class="px-6 pt-16 pb-32">
    <div class="mx-auto max-w-3xl">
      <SiteNav current="notation" />
      <header class="mb-12">
        <div class="mb-8 flex items-center gap-4">
          <div class="h-[2px] w-12 bg-stone-900"></div>
          <div class="micro-label text-[11px] tracking-[0.4em] text-stone-900">Reference</div>
        </div>
        <h1 class="display mb-6 text-5xl leading-[1.05] sm:text-6xl">Notation.</h1>
        <p class="max-w-2xl text-xl leading-relaxed font-light text-stone-500 italic">
          The book uses the same symbol for the same thing in every chapter. Here they all are.
        </p>
      </header>

      <dl class="border-t-2 border-stone-900">
        {
          symbols.map((s) => (
            <div id={s.id} class="entry grid grid-cols-[4.5rem_1fr] items-baseline gap-4 border-b border-stone-100 py-3.5">
              <dt class="symbol text-2xl text-stone-900">{s.data.symbol}</dt>
              <dd class="text-base leading-relaxed text-stone-700">{s.data.meaning}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </main>
</BaseLayout>

<style>
  .symbol {
    font-family: 'KaTeX_Math', 'Times New Roman', serif;
    font-style: italic;
  }
  .entry:target {
    margin-inline: -0.75rem;
    padding-inline: 0.75rem;
    background: var(--accent-soft);
  }
</style>
