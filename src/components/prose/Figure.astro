---
/** Framed, auto-numbered interactive. The caption should tell the reader what to try. */
interface Props {
  title: string;
  caption?: string;
  /** A concrete thing for the reader to do. */
  try?: string;
}
const { title, caption, try: tryIt } = Astro.props;
---

<figure class="book-figure my-16 rounded-sm border-2 border-stone-900 p-5 sm:p-8" style="counter-increment: figure">
  <header class="mb-6 flex items-start justify-between gap-4">
    <div>
      <div class="flex items-baseline"><div class="figure-number text-sm font-bold tracking-widest uppercase">Figure</div><span data-anchor-slot></span></div>
      <p class="text-xs text-stone-500 italic">{title}</p>
    </div>
    <span class="flex shrink-0 flex-wrap justify-end gap-2">
    <button
      type="button"
      hidden
      data-figure-expand
      title="Let this figure fill the screen"
      class="micro-label cursor-pointer rounded border border-stone-200 px-2 py-1 text-stone-500 transition-colors hover:border-stone-900 hover:text-stone-900"
    >
      ⤢ Expand
    </button>
    <button
      type="button"
      hidden
      data-figure-reset
      title="Put this figure back the way it started"
      class="micro-label cursor-pointer rounded border border-stone-200 px-2 py-1 text-stone-500 transition-colors hover:border-stone-900 hover:text-stone-900"
    >
      ↺ Start over
    </button>
    </span>
  </header>
  <div class="not-prose text-base" data-figure-body data-pagefind-ignore><slot /></div>
  {/* Runs the moment the figure has been read from the page, before it wakes up, to keep an untouched copy. */}
  <script is:inline>
    document.currentScript.previousElementSibling.pristine = document.currentScript.previousElementSibling.innerHTML;
  </script>
  {
    (caption || tryIt) && (
      <figcaption class="mt-6 border-t border-stone-100 pt-4 text-[12px] leading-relaxed text-stone-500">
        {caption && <span>{caption} </span>}
        {tryIt && (
          <span>
            <span class="font-bold text-orange-700">Try it:</span> {tryIt}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<script>
  // "Start over" rebuilds a figure from the page as it first arrived, which
  // works for every figure without each one needing its own reset logic.
  for (const figure of document.querySelectorAll<HTMLElement>('figure.book-figure')) {
    const body = figure.querySelector<HTMLElement & { pristine?: string }>('[data-figure-body]');
    const button = figure.querySelector<HTMLButtonElement>('[data-figure-reset]');
    const pristine = body?.pristine;
    if (!body || !button || !pristine?.includes('<astro-island')) continue;
    // Figures that already have their own Reset button do not need a second one.
    if ([...body.querySelectorAll('button')].some((b) => b.textContent?.trim().toLowerCase() === 'reset')) continue;

    button.hidden = false;
    button.addEventListener('click', () => {
      body.style.minHeight = `${body.offsetHeight}px`; // no jump while the figure rebuilds
      body.innerHTML = pristine;
      setTimeout(() => (body.style.minHeight = ''), 600);
    });
  }
</script>
