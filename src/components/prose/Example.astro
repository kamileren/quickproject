---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<div class="my-10 rounded border border-stone-200 bg-white p-6">
  <div class="mb-3 flex flex-wrap items-baseline gap-3">
    <span class="micro-label text-orange-600">Example</span>
    {title && <span class="text-sm font-bold text-stone-900">{title}</span>}
  </div>
  <div class="text-base leading-relaxed text-stone-700 [&>p+p]:mt-3 [&_ol]:mt-3 [&_ul]:mt-3"><slot /></div>
</div>
