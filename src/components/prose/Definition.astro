---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="my-10 border-l-2 border-stone-900 bg-stone-50/30 py-2 pl-6" style="counter-increment: definition">
  <div class="mb-2 flex flex-wrap items-baseline gap-2">
    <span class="definition-number text-sm font-bold tracking-tight text-stone-900 uppercase">Definition</span>
    <span class="text-sm font-bold tracking-tight text-stone-700 italic">{title}</span>
  </div>
  <div class="text-[15px] leading-relaxed text-stone-700 italic [&>p+p]:mt-3"><slot /></div>
</div>
