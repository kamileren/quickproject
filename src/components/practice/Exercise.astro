---
/**
 * One exercise. The question is the content; the worked answer goes in a
 * <Solution> block at the end of it.
 */
interface Props {
  /** What kind of work it asks for. */
  kind?: 'by hand' | 'with the figure' | 'in code' | 'think';
}
const { kind = 'think' } = Astro.props;
---

<div class="exercise mb-6 rounded border border-stone-200 p-4 sm:p-6" style="counter-increment: exercise">
  <div class="exercise-head mb-2 flex flex-wrap items-baseline gap-3">
    <span class="exercise-number micro-label text-stone-900">Exercise</span>
    <span class="micro-label font-normal tracking-widest text-stone-500">{kind}</span>
  </div>
  <div class="text-base leading-relaxed text-stone-800 [&_ol]:mt-3 [&_ul]:mt-3 [&>p+p]:mt-3"><slot /></div>
</div>
